{
  "name": "policy-codex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite-node prototypes/blind-b/scripts/build-data.ts && vite -c prototypes/blind-b/vite.config.ts",
    "build": "npm run build:blind-b",
    "build:blind-b": "vite-node prototypes/blind-b/scripts/build-data.ts && vite build -c prototypes/blind-b/vite.config.ts --outDir ../../.artifacts/blind-b --emptyOutDir",
    "preview": "vite preview -c prototypes/blind-b/vite.config.ts --outDir ../../.artifacts/blind-b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "vite-node scripts/migrate-ledger.mjs",
    "handoff": "vite-node scripts/handoff.ts",
    "governance": "vite-node scripts/governance-report.ts",
    "conformance": "vite-node scripts/conformance.ts",
    "conform": "vite-node scripts/conform.ts",
    "conform:self": "vite-node scripts/conform.ts --build --batch --adapter \"npx vite-node scripts/adapters/codex-self.ts\"",
    "export": "vite-node scripts/export.ts",
    "check": "vite-node scripts/check.ts",
    "fingerprint": "vite-node scripts/fingerprint.ts",
    "boundaries": "vite-node scripts/boundaries.ts",
    "receipts:harness": "vite-node scripts/receipts/harness.ts",
    "records:harness": "vite-node scripts/records/harness.ts",
    "external:template": "vite-node scripts/external/template.ts",
    "external:import": "vite-node scripts/external/import.ts",
    "external:check": "vite-node scripts/external/check.ts",
    "report-checks": "vite-node scripts/report-only-checks.ts"
  },
  "dependencies": {
    "@preact/signals": "1.3.2",
    "preact": "10.25.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vite-node": "2.1.8",
    "vitest": "2.1.8"
  }
}
