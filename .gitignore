.venv/
__pycache__/
*.pyc
.env
*.env
!*.env.example

node_modules/
dist/

# generated by `npm run conformance` / `npm run conform`; not deterministic
# across runs (each carries a fresh `generated` timestamp)
conformance/suite.json
conformance/results.json
conformance/*/suite.json
conformance/*/results.json
conformance/*/ledger.json

# static builds (`npm run build`: the Rulebook, into .artifacts/blind-b/)
.artifacts/
vite.config.ts.timestamp-*

# blind-b generated data (scripts/build-data.ts)
prototypes/blind-b/public/

# external sample check (docs/external-check.md): case files received from
# county or State staff stay on the machine that runs the check. Only the
# blank template and the made-up example are committed.
external-check/*
!external-check/template/
!external-check/example/
